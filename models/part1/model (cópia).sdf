<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="Part1">
    <static>1</static>

    <link name="part1_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- 🔹 INÉRCIA (ESSENCIAL) -->
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-4</iyy>
          <iyz>0</iyz>
          <izz>1e-4</izz>
        </inertia>
      </inertial>

      <!-- 🔹 COLLISION -->
      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>

        <geometry>
          <mesh>
            <uri>model://part1/meshes/part1.dae</uri>
            <scale>1.1 1.1 1.4</scale>
          </mesh>
        </geometry>

        <!-- 🔹 FÍSICA DE CONTATO (CRÍTICO) -->
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>

          <contact>
            <ode>
              <kp>1e+13</kp>
              <kd>5</kd>
              <min_depth>0.003</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>

          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
          </bounce>
        </surface>
      </collision>

      <!-- 🔹 VISUAL -->
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>

        <geometry>
          <mesh>
            <uri>model://part1/meshes/part1.dae</uri>
            <scale>1.1 1.1 1.4</scale>
          </mesh>
        </geometry>

        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name>
          </script>
        </material>
      </visual>

      <!-- 🔹 FLAGS IMPORTANTES -->
      <self_collide>0</self_collide>
      <kinematic>0</kinematic>

    </link>

    <allow_auto_disable>1</allow_auto_disable>
  </model>
</sdf>
