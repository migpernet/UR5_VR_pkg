<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="Bico_dosador">
    <static>1</static>

    <link name="bico_dosador_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>0.25</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://bico_dosador/meshes/bico_dosador.dae</uri>
            <scale>0.8 0.8 0.8</scale>
          </mesh>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.5</mu> <mu2>1.5</mu2>
            </ode>
          </friction>

          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>10.0</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.1</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://bico_dosador/meshes/bico_dosador.dae</uri>
            <scale>0.8 0.8 0.8</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name>
          </script>
        </material>
      </visual>

    </link>
  </model>
</sdf>

