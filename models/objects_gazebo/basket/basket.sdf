<?xml version='1.0'?>
<sdf version='1.4'>
  <model name="basket">
    <static>True</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.07</mass>
        <inertia>
          <ixx>0.000010</ixx>
          <iyy>0.000010</iyy>
          <izz>0.000010</izz>
        </inertia>
      </inertial>
      <collision name="collision">
      <pose>0 0 0.029 1.57 0 1.57</pose> 
        <geometry>
          <mesh>
  	        <scale>0.0011 0.0011 0.0011</scale>
            <uri>model://basket/meshes/basket.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      

      <collision name="collision_fundo">
        <pose>0 0 0.002 1.57 0 1.57</pose> 
        <geometry>
          <box>
          	<size>0.35 0.006 0.25</size>
          </box> 
        </geometry>
        <surface>
          <contact><ode><min_depth>0.003</min_depth></ode></contact>
        </surface>
      </collision>    
      
      
      <visual name="visual">
      <pose>0 0 0.029 1.57 0 1.57</pose> 
        <geometry>
          <mesh>
  	    <scale>0.0011 0.0011 0.0011</scale>
            <uri>model://basket/meshes/basket.dae</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Blue</name>
          </script>
          <!--ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse-->
        </material> 
      </visual>  
    </link>    
  </model>
</sdf>
