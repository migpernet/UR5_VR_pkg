<?xml version="1.0"?>
<launch>
    <!-- ==================================================================== -->
    <!-- ARGUMENTOS CONFIGURÁVEIS (Configure o IP e o arquivo .yaml aqui)     -->
    <!-- ==================================================================== -->
    <arg name="robot_ip" default="192.168.1.10" />
    <arg name="kinematics_config" default="$(find UR5_VR_pkg)/config/calibracao_ur5.yaml" />

    <!-- ==================================================================== -->
    <!-- DESCRIÇÃO DO ROBÓ_REAL (Injeta o seu XACRO + Calibração de Fábrica)   -->
    <!-- ==================================================================== -->
    <!-- O driver real exige que a calibração seja passada para o arquivo xacro -->
    <param name="robot_description" command="$(find xacro)/xacro $(find UR5_VR_pkg)/urdf/ur5_gripper_140_cam.xacro kinematics_config:=$(arg kinematics_config)" />

    <!-- ==================================================================== -->
    <!-- DRIVER OFICIAL DO ROBÔ REAL (Substitui o Gazebo)                     -->
    <!-- ==================================================================== -->
    <include file="$(find ur_robot_driver)/launch/ur5_bringup.launch">
        <arg name="robot_ip" value="$(arg robot_ip)" />
        <arg name="kinematics_config" value="$(arg kinematics_config)" />
    </include>

    <!-- O driver real já publica /joint_states e robot_state_publisher automaticamente -->

    <!-- ==================================================================== -->
    <!-- PIPELINE DE VISÃO (Mantido exatamente igual para filtrar a câmera real)-->
    <!-- ==================================================================== -->
    <!-- PASSO 1: VoxelGrid -->
    <node pkg="nodelet" type="nodelet" name="voxel_grid_filter" args="standalone pcl/VoxelGrid" output="screen">
        <remap from="~input" to="/camera/depth/color/points" />
        <remap from="~output" to="/points_voxelized_temp" />
        <param name="leaf_size" value="0.005" />
        <param name="output_frame" value="base_link" />
    </node>

    <!-- PASSO 2: PassThrough Filter -->
    <node pkg="nodelet" type="nodelet" name="passthrough_z" args="standalone pcl/PassThrough" output="screen">
        <remap from="~input" to="/points_voxelized_temp" />
        <remap from="~output" to="/points_fixed_to_base" />
        <param name="filter_field_name" value="z" />
        <param name="filter_limit_min" value="0.005" />
        <param name="filter_limit_max" value="0.40" />
        <param name="filter_limit_negative" value="false" />
    </node>

    <!-- ==================================================================== -->
    <!-- PIPELINE DE MOVIMENTO (MoveIt & RViz vinculados ao Robô Real)         -->
    <!-- ==================================================================== -->
    <include file="$(find ur_gripper_140_moveit_config)/launch/planning_context.launch">
        <arg name="load_robot_description" value="false" />
    </include>

    <include file="$(find ur_gripper_140_moveit_config)/launch/move_group.launch">
        <arg name="publish_monitored_planning_scene" value="true" />
    </include>

    <include file="$(find ur_gripper_140_moveit_config)/launch/moveit_rviz.launch">
        <arg name="rviz_config" value="$(find ur_gripper_140_moveit_config)/launch/moveit.rviz" />
    </include>
</launch>
