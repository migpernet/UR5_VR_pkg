<?xml version="1.0"?>
<launch>

    <!-- ==================================================================== -->
    <!-- ARGUMENTOS CONFIGURÁVEIS (Rede física do laboratório)                -->
    <!-- ==================================================================== -->
    <arg name="robot_ip" default="192.168.1.3" />

    <!-- ==================================================================== -->
    <!-- DESCRIÇÃO DO ROBÔ REAL (Apenas XACRO sem calibração externa)         -->
    <!-- ==================================================================== -->
    <param name="robot_description" command="$(find xacro)/xacro $(find UR5_VR_pkg)/urdf/ur5_gripper_140_cam.xacro" />

    <!-- ==================================================================== -->
    <!-- DRIVERS DE HARDWARE (Braço, Câmera e Garra)                          -->
    <!-- ==================================================================== -->
    
    <!-- 1. Driver do Braço UR5 (Sintaxe idêntica à do laboratório) -->
    <include file="$(find ur_modern_driver)/launch/ur5_bringup.launch">
        <arg name="robot_ip" value="$(arg robot_ip)" />
    </include>

    <!-- 2. Driver da Garra Robotiq 140 -->
    <node pkg="robotiq_2f_gripper_control" type="Robotiq2FGripperRtuNode.py" name="robotiq_gripper" args="/dev/ttyUSB0" output="screen" />

    <!-- 3. Driver da Intel RealSense (com filtro de pointcloud ativado) -->
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="filters" value="pointcloud" />
    </include>

    <!-- ==================================================================== -->
    <!-- PIPELINE DE VISÃO: ALTA DENSIDADE, BAIXO PESO                        -->
    <!-- ==================================================================== -->

    <!-- PASSO 1: VoxelGrid (Converte para Global e aplica densidade fina) -->
    <node pkg="nodelet" type="nodelet" name="voxel_grid_filter" args="standalone pcl/VoxelGrid" output="screen">
        <remap from="~input" to="/camera/depth/color/points" />
        <remap from="~output" to="/points_voxelized_temp" /> 
        <param name="leaf_size" value="0.005" /> 
        <param name="output_frame" value="base_link" /> 
    </node>

    <!-- PASSO 2: PassThrough Filter (A Guilhotina: Remove a Mesa e o Teto) -->
    <node pkg="nodelet" type="nodelet" name="passthrough_z" args="standalone pcl/PassThrough" output="screen">
        <remap from="~input" to="/points_voxelized_temp" />
        <remap from="~output" to="/points_fixed_to_base" /> 
        <param name="filter_field_name" value="z" /> 
        <param name="filter_limit_min" value="0.005" /> 
        <param name="filter_limit_max" value="0.40" /> 
        <param name="filter_limit_negative" value="false" />
    </node>

    <!-- ==================================================================== -->
    <!-- INTERFACE DE MOVIMENTO (MoveIt integrado ao Hardware Real)           -->
    <!-- ==================================================================== -->
    
    <include file="$(find ur_gripper_140_moveit_config)/launch/planning_context.launch" >
        <arg name="load_robot_description" value="false" />
    </include>

    <include file="$(find ur_gripper_140_moveit_config)/launch/move_group.launch" >
        <arg name="publish_monitored_planning_scene" value="true" />
    </include>
    
</launch>

